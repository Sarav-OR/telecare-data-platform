		{
			"name": "[concat(parameters('factoryName'), '/pl_run_databricks_job')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Starts the Databricks ingestion job (Jobs API run-now, managed identity), polls every minute until it ends, and fails this pipeline if the run did not succeed. The ADF run id is passed on for lineage.",
				"activities": [
					{
						"name": "web_run_now",
						"type": "WebActivity",
						"dependsOn": [],
						"policy": {
							"timeout": "0.01:00:00",
							"retry": 1,
							"retryIntervalInSeconds": 60,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"method": "POST",
							"headers": {
								"Content-Type": "application/json"
							},
							"url": {
								"value": "@concat(pipeline().parameters.workspace_url, '/api/2.1/jobs/run-now')",
								"type": "Expression"
							},
							"body": {
								"value": "@json(concat('{\"job_id\": ', pipeline().parameters.job_id, ', \"job_parameters\": {\"orchestrator_run_id\": \"', pipeline().parameters.run_id, '\"}}'))",
								"type": "Expression"
							},
							"authentication": {
								"type": "MSI",
								"resource": "2ff814a6-3304-4ab8-85cb-cd0e6f879c1d"
							}
						}
					},
					{
						"name": "until_run_finished",
						"type": "Until",
						"dependsOn": [
							{
								"activity": "web_run_now",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@contains(createArray('TERMINATED', 'SKIPPED', 'INTERNAL_ERROR'), variables('life_cycle_state'))",
								"type": "Expression"
							},
							"activities": [
								{
									"name": "wait_60s",
									"type": "Wait",
									"dependsOn": [],
									"userProperties": [],
									"typeProperties": {
										"waitTimeInSeconds": 60
									}
								},
								{
									"name": "web_get_run",
									"type": "WebActivity",
									"dependsOn": [
										{
											"activity": "wait_60s",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.01:00:00",
										"retry": 3,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"method": "GET",
										"headers": {},
										"url": {
											"value": "@concat(pipeline().parameters.workspace_url, '/api/2.1/jobs/runs/get?run_id=', string(activity('web_run_now').output.run_id))",
											"type": "Expression"
										},
										"authentication": {
											"type": "MSI",
											"resource": "2ff814a6-3304-4ab8-85cb-cd0e6f879c1d"
										}
									}
								},
								{
									"name": "set_life_cycle_state",
									"type": "SetVariable",
									"dependsOn": [
										{
											"activity": "web_get_run",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "life_cycle_state",
										"value": {
											"value": "@activity('web_get_run').output.state.life_cycle_state",
											"type": "Expression"
										}
									}
								},
								{
									"name": "set_result_state",
									"type": "SetVariable",
									"dependsOn": [
										{
											"activity": "web_get_run",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "result_state",
										"value": {
											"value": "@coalesce(activity('web_get_run').output.state?.result_state, '')",
											"type": "Expression"
										}
									}
								},
								{
									"name": "set_state_message",
									"type": "SetVariable",
									"dependsOn": [
										{
											"activity": "web_get_run",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "state_message",
										"value": {
											"value": "@coalesce(activity('web_get_run').output.state?.state_message, '')",
											"type": "Expression"
										}
									}
								}
							],
							"timeout": "0.02:00:00"
						}
					},
					{
						"name": "if_run_failed",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "until_run_finished",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@not(equals(variables('result_state'), 'SUCCESS'))",
								"type": "Expression"
							},
							"ifTrueActivities": [
								{
									"name": "fail_databricks_run",
									"type": "Fail",
									"dependsOn": [],
									"userProperties": [],
									"typeProperties": {
										"message": {
											"value": "@concat('Databricks run ', string(activity('web_run_now').output.run_id), ' ended ', variables('life_cycle_state'), '/', variables('result_state'), ': ', variables('state_message'))",
											"type": "Expression"
										},
										"errorCode": "DATABRICKS_RUN_FAILED"
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"run_id": {
						"type": "string"
					},
					"workspace_url": {
						"type": "string",
						"defaultValue": "https://adb-7405609552599914.14.azuredatabricks.net"
					},
					"job_id": {
						"type": "string",
						"defaultValue": "175309398118457"
					}
				},
				"variables": {
					"life_cycle_state": {
						"type": "String",
						"defaultValue": "PENDING"
					},
					"result_state": {
						"type": "String"
					},
					"state_message": {
						"type": "String"
					}
				},
				"folder": {
					"name": "telecare/orchestrate"
				},
				"annotations": []
			},
			"dependsOn": []
		},
