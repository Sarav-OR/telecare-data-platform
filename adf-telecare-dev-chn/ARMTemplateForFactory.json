{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-telecare-dev-chn"
		},
		"ls_adls_lake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://sttelecaredevchn.dfs.core.windows.net/"
		},
		"ls_rest_partner_api_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://sttelecaredevchn.z1.web.core.windows.net/api/"
		},
		"ls_sql_ehr_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-telecare-dev-chn.database.windows.net"
		},
		"ls_sql_ehr_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqldb-telecare-ehr"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/pl_copy_file_feeds')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Vendor file deliveries of one business date: vendor-drop -> landing (binary, folder structure kept). Feeds and their folder layout come from ctl.file_feed; a feed due on the date but missing fails the run.",
				"activities": [
					{
						"name": "lkp_feeds_due",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.01:00:00",
							"retry": 2,
							"retryIntervalInSeconds": 60,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "@concat('SELECT feed_name, folder_prefix, date_path_format FROM ctl.file_feed WHERE is_active = 1 ','AND (delivery_day IS NULL OR delivery_day = DATENAME(weekday, CAST(''', pipeline().parameters.run_date, ''' AS date)))')",
									"type": "Expression"
								},
								"queryTimeout": "00:10:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "ds_sql_ehr",
								"type": "DatasetReference",
								"parameters": {}
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "fe_feed",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "lkp_feeds_due",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('lkp_feeds_due').output.value",
								"type": "Expression"
							},
							"isSequential": false,
							"batchCount": 4,
							"activities": [
								{
									"name": "get_delivery_folder",
									"type": "GetMetadata",
									"dependsOn": [],
									"policy": {
										"timeout": "0.01:00:00",
										"retry": 2,
										"retryIntervalInSeconds": 60,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"dataset": {
											"referenceName": "ds_adls_binary",
											"type": "DatasetReference",
											"parameters": {
												"container": "vendor-drop",
												"folder": {
													"value": "@concat(item().folder_prefix, '/', formatDateTime(pipeline().parameters.run_date, item().date_path_format))",
													"type": "Expression"
												}
											}
										},
										"fieldList": [
											"exists"
										],
										"storeSettings": {
											"type": "AzureBlobFSReadSettings",
											"recursive": true
										},
										"formatSettings": {
											"type": "BinaryReadSettings"
										}
									}
								},
								{
									"name": "if_delivered",
									"type": "IfCondition",
									"dependsOn": [
										{
											"activity": "get_delivery_folder",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"userProperties": [],
									"typeProperties": {
										"expression": {
											"value": "@activity('get_delivery_folder').output.exists",
											"type": "Expression"
										},
										"ifFalseActivities": [
											{
												"name": "fail_missing_delivery",
												"type": "Fail",
												"dependsOn": [],
												"userProperties": [],
												"typeProperties": {
													"message": {
														"value": "@concat('Delivery missing: feed ', item().feed_name, ' for ', pipeline().parameters.run_date, ' (expected vendor-drop/', concat(item().folder_prefix, '/', formatDateTime(pipeline().parameters.run_date, item().date_path_format)), ')')",
														"type": "Expression"
													},
													"errorCode": "MISSING_DELIVERY"
												}
											}
										],
										"ifTrueActivities": [
											{
												"name": "copy_feed",
												"type": "Copy",
												"dependsOn": [],
												"policy": {
													"timeout": "0.01:00:00",
													"retry": 2,
													"retryIntervalInSeconds": 60,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"source": {
														"type": "BinarySource",
														"storeSettings": {
															"type": "AzureBlobFSReadSettings",
															"recursive": true
														}
													},
													"sink": {
														"type": "BinarySink",
														"storeSettings": {
															"type": "AzureBlobFSWriteSettings",
															"copyBehavior": "PreserveHierarchy"
														}
													},
													"enableStaging": false
												},
												"inputs": [
													{
														"referenceName": "ds_adls_binary",
														"type": "DatasetReference",
														"parameters": {
															"container": "vendor-drop",
															"folder": {
																"value": "@concat(item().folder_prefix, '/', formatDateTime(pipeline().parameters.run_date, item().date_path_format))",
																"type": "Expression"
															}
														}
													}
												],
												"outputs": [
													{
														"referenceName": "ds_adls_binary",
														"type": "DatasetReference",
														"parameters": {
															"container": "landing",
															"folder": {
																"value": "@concat(item().folder_prefix, '/', formatDateTime(pipeline().parameters.run_date, item().date_path_format))",
																"type": "Expression"
															}
														}
													}
												]
											}
										]
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"run_date": {
						"type": "string"
					},
					"run_id": {
						"type": "string"
					}
				},
				"folder": {
					"name": "telecare/ingest"
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_sql_ehr')]",
				"[concat(variables('factoryId'), '/datasets/ds_adls_binary')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_copy_partner_api')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Partner directory from the CRM REST API (weekly, Mondays): follows the $.next link of every page and writes one JSON object per partner to landing/crm/partners/<date>/.",
				"activities": [
					{
						"name": "if_snapshot_day",
						"type": "IfCondition",
						"dependsOn": [],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@equals(dayOfWeek(pipeline().parameters.run_date), 1)",
								"type": "Expression"
							},
							"ifTrueActivities": [
								{
									"name": "copy_partners_api",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.01:00:00",
										"retry": 2,
										"retryIntervalInSeconds": 60,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "RestSource",
											"httpRequestTimeout": "00:01:40",
											"requestInterval": "00.00:00:00.010",
											"requestMethod": "GET",
											"paginationRules": {
												"AbsoluteUrl": "$.next"
											}
										},
										"sink": {
											"type": "JsonSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "JsonWriteSettings",
												"filePattern": "setOfObjects"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"mappings": [
												{
													"source": {
														"path": "[['partnerId']"
													},
													"sink": {
														"path": "$['partnerId']"
													}
												},
												{
													"source": {
														"path": "[['type']"
													},
													"sink": {
														"path": "$['type']"
													}
												},
												{
													"source": {
														"path": "[['name']"
													},
													"sink": {
														"path": "$['name']"
													}
												},
												{
													"source": {
														"path": "[['connectEnabled']"
													},
													"sink": {
														"path": "$['connectEnabled']"
													}
												},
												{
													"source": {
														"path": "[['active']"
													},
													"sink": {
														"path": "$['active']"
													}
												},
												{
													"source": {
														"path": "[['openedOn']"
													},
													"sink": {
														"path": "$['openedOn']"
													}
												},
												{
													"source": {
														"path": "[['deactivatedOn']"
													},
													"sink": {
														"path": "$['deactivatedOn']"
													}
												},
												{
													"source": {
														"path": "[['address']['city']"
													},
													"sink": {
														"path": "$['city']"
													}
												},
												{
													"source": {
														"path": "[['address']['postalCode']"
													},
													"sink": {
														"path": "$['postalCode']"
													}
												},
												{
													"source": {
														"path": "[['address']['canton']"
													},
													"sink": {
														"path": "$['canton']"
													}
												},
												{
													"source": {
														"path": "$['snapshot_date']"
													},
													"sink": {
														"path": "$['snapshot_date']"
													}
												}
											],
											"collectionReference": "$['data']"
										}
									},
									"inputs": [
										{
											"referenceName": "ds_rest_partners",
											"type": "DatasetReference",
											"parameters": {
												"relative_url": {
													"value": "@concat('partners/', pipeline().parameters.run_date, '/page-0001.json')",
													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "ds_adls_json",
											"type": "DatasetReference",
											"parameters": {
												"container": "landing",
												"folder": {
													"value": "@concat('crm/partners/', pipeline().parameters.run_date)",
													"type": "Expression"
												},
												"file": "partners.json"
											}
										}
									]
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"run_date": {
						"type": "string"
					},
					"run_id": {
						"type": "string"
					}
				},
				"folder": {
					"name": "telecare/ingest"
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_rest_partners')]",
				"[concat(variables('factoryId'), '/datasets/ds_adls_json')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_extract_ehr')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Incremental watermark extract of the EHR tables (Azure SQL) for one business date -> Parquet in landing. Window: [watermark, run_date + 1 day). The watermark moves only after a successful copy.",
				"activities": [
					{
						"name": "lkp_tables",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.01:00:00",
							"retry": 2,
							"retryIntervalInSeconds": 60,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": "SELECT table_name, select_list, watermark_column, CONVERT(varchar(19), watermark_value, 120) AS watermark_value FROM ctl.sql_extract WHERE is_active = 1",
								"queryTimeout": "00:10:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "ds_sql_ehr",
								"type": "DatasetReference",
								"parameters": {}
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "fe_table",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "lkp_tables",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('lkp_tables').output.value",
								"type": "Expression"
							},
							"isSequential": false,
							"batchCount": 4,
							"activities": [
								{
									"name": "copy_table_increment",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.01:00:00",
										"retry": 2,
										"retryIntervalInSeconds": 60,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "AzureSqlSource",
											"sqlReaderQuery": {
												"value": "SELECT @{item().select_list} FROM ehr.@{item().table_name} WHERE @{item().watermark_column} >= '@{item().watermark_value}' AND @{item().watermark_column} < '@{formatDateTime(addDays(pipeline().parameters.run_date, 1), 'yyyy-MM-dd')} 00:00:00'",
												"type": "Expression"
											},
											"queryTimeout": "01:00:00",
											"partitionOption": "None"
										},
										"sink": {
											"type": "ParquetSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "ParquetWriteSettings"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": false,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "ds_sql_ehr",
											"type": "DatasetReference",
											"parameters": {}
										}
									],
									"outputs": [
										{
											"referenceName": "ds_adls_parquet",
											"type": "DatasetReference",
											"parameters": {
												"container": "landing",
												"folder": {
													"value": "@concat('ehr/', item().table_name, '/load_date=', pipeline().parameters.run_date)",
													"type": "Expression"
												},
												"file": {
													"value": "@concat(item().table_name, '.snappy.parquet')",
													"type": "Expression"
												}
											}
										}
									]
								},
								{
									"name": "sp_move_watermark",
									"type": "SqlServerStoredProcedure",
									"dependsOn": [
										{
											"activity": "copy_table_increment",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.01:00:00",
										"retry": 2,
										"retryIntervalInSeconds": 60,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"storedProcedureName": "[[ctl].[usp_set_watermark]",
										"storedProcedureParameters": {
											"table_name": {
												"value": {
													"value": "@item().table_name",
													"type": "Expression"
												},
												"type": "String"
											},
											"watermark_value": {
												"value": {
													"value": "@concat(formatDateTime(addDays(pipeline().parameters.run_date, 1), 'yyyy-MM-dd'), ' 00:00:00')",
													"type": "Expression"
												},
												"type": "String"
											},
											"row_count": {
												"value": {
													"value": "@activity('copy_table_increment').output.rowsCopied",
													"type": "Expression"
												},
												"type": "Int64"
											}
										}
									},
									"linkedServiceName": {
										"referenceName": "ls_sql_ehr",
										"type": "LinkedServiceReference"
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"run_date": {
						"type": "string"
					},
					"run_id": {
						"type": "string"
					}
				},
				"folder": {
					"name": "telecare/ingest"
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_sql_ehr')]",
				"[concat(variables('factoryId'), '/datasets/ds_adls_parquet')]",
				"[concat(variables('factoryId'), '/linkedServices/ls_sql_ehr')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_master_daily')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Entry point (scheduled). Reads the next business date from ctl.batch_state and runs it, or does nothing when the sources have no newer day. Concurrency 1: runs never overlap.",
				"activities": [
					{
						"name": "lkp_next_business_date",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.01:00:00",
							"retry": 2,
							"retryIntervalInSeconds": 60,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": "SELECT CONVERT(varchar(10), DATEADD(day, 1, last_completed_date), 23) AS run_date, CASE WHEN DATEADD(day, 1, last_completed_date) <= end_date THEN 1 ELSE 0 END AS has_work FROM ctl.batch_state WHERE batch_name = 'telecare_daily'",
								"queryTimeout": "00:10:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "ds_sql_ehr",
								"type": "DatasetReference",
								"parameters": {}
							},
							"firstRowOnly": true
						}
					},
					{
						"name": "if_new_business_date",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "lkp_next_business_date",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@equals(activity('lkp_next_business_date').output.firstRow.has_work, 1)",
								"type": "Expression"
							},
							"ifTrueActivities": [
								{
									"name": "run_business_date",
									"type": "ExecutePipeline",
									"dependsOn": [],
									"policy": {
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"pipeline": {
											"referenceName": "pl_run_business_date",
											"type": "PipelineReference"
										},
										"waitOnCompletion": true,
										"parameters": {
											"run_date": {
												"value": "@activity('lkp_next_business_date').output.firstRow.run_date",
												"type": "Expression"
											},
											"run_id": {
												"value": "@pipeline().RunId",
												"type": "Expression"
											}
										}
									}
								}
							]
						}
					}
				],
				"concurrency": 1,
				"policy": {
					"elapsedTimeMetric": {}
				},
				"folder": {
					"name": "telecare/orchestrate"
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_sql_ehr')]",
				"[concat(variables('factoryId'), '/pipelines/pl_run_business_date')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_run_business_date')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "One business date end to end: the three extracts in parallel -> Databricks landing->bronze->silver -> advance the batch clock. Any failure is logged to ctl.run_log and re-raised (try/catch/rethrow).",
				"activities": [
					{
						"name": "log_started",
						"type": "SqlServerStoredProcedure",
						"dependsOn": [],
						"policy": {
							"timeout": "0.01:00:00",
							"retry": 2,
							"retryIntervalInSeconds": 60,
