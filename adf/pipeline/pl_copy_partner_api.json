{
    "name": "pl_copy_partner_api",
    "properties": {
        "description": "Partner directory from the CRM REST API (weekly, Mondays): follows the $.next link of every page and writes one JSON object per partner to landing/crm/partners/<date>/.",
        "folder": {
            "name": "telecare/ingest"
        },
        "parameters": {
            "run_date": {
                "type": "string"
            },
            "run_id": {
                "type": "string"
            }
        },
        "annotations": [],
        "activities": [
            {
                "name": "if_snapshot_day",
                "type": "IfCondition",
                "dependsOn": [],
                "typeProperties": {
                    "expression": {
                        "value": "@equals(dayOfWeek(pipeline().parameters.run_date), 1)",
                        "type": "Expression"
                    },
                    "ifTrueActivities": [
                        {
                            "name": "copy_partners_api",
                            "type": "Copy",
                            "policy": {
                                "timeout": "0.01:00:00",
                                "retry": 2,
                                "retryIntervalInSeconds": 60,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "dependsOn": [],
                            "typeProperties": {
                                "source": {
                                    "type": "RestSource",
                                    "httpRequestTimeout": "00:01:40",
                                    "requestInterval": "00.00:00:00.010",
                                    "requestMethod": "GET",
                                    "paginationRules": {
                                        "AbsoluteUrl": "$.next"
                                    }
                                },
                                "sink": {
                                    "type": "JsonSink",
                                    "storeSettings": {
                                        "type": "AzureBlobFSWriteSettings"
                                    },
                                    "formatSettings": {
                                        "type": "JsonWriteSettings",
                                        "filePattern": "setOfObjects"
                                    }
                                },
                                "enableStaging": false,
                                "translator": {
                                    "type": "TabularTranslator",
                                    "collectionReference": "$['data']",
                                    "mappings": [
                                        {
                                            "source": {
                                                "path": "['partnerId']"
                                            },
                                            "sink": {
                                                "path": "$['partnerId']"
                                            }
                                        },
                                        {
                                            "source": {
                                                "path": "['type']"
                                            },
                                            "sink": {
                                                "path": "$['type']"
                                            }
                                        },
                                        {
                                            "source": {
                                                "path": "['name']"
                                            },
                                            "sink": {
                                                "path": "$['name']"
                                            }
                                        },
                                        {
                                            "source": {
                                                "path": "['connectEnabled']"
                                            },
                                            "sink": {
                                                "path": "$['connectEnabled']"
                                            }
                                        },
                                        {
                                            "source": {
                                                "path": "['active']"
                                            },
                                            "sink": {
                                                "path": "$['active']"
                                            }
                                        },
                                        {
                                            "source": {
                                                "path": "['openedOn']"
                                            },
                                            "sink": {
                                                "path": "$['openedOn']"
                                            }
                                        },
                                        {
                                            "source": {
                                                "path": "['deactivatedOn']"
                                            },
                                            "sink": {
                                                "path": "$['deactivatedOn']"
                                            }
                                        },
                                        {
                                            "source": {
                                                "path": "['address']['city']"
                                            },
                                            "sink": {
                                                "path": "$['city']"
                                            }
                                        },
                                        {
                                            "source": {
                                                "path": "['address']['postalCode']"
                                            },
                                            "sink": {
                                                "path": "$['postalCode']"
                                            }
                                        },
                                        {
                                            "source": {
                                                "path": "['address']['canton']"
                                            },
                                            "sink": {
                                                "path": "$['canton']"
                                            }
                                        },
                                        {
                                            "source": {
                                                "path": "$['snapshot_date']"
                                            },
                                            "sink": {
                                                "path": "$['snapshot_date']"
                                            }
                                        }
                                    ]
                                }
                            },
                            "inputs": [
                                {
                                    "referenceName": "ds_rest_partners",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "relative_url": {
                                            "value": "@concat('partners/', pipeline().parameters.run_date, '/page-0001.json')",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ],
                            "outputs": [
                                {
                                    "referenceName": "ds_adls_json",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "container": "landing",
                                        "folder": {
                                            "value": "@concat('crm/partners/', pipeline().parameters.run_date)",
                                            "type": "Expression"
                                        },
                                        "file": "partners.json"
                                    }
                                }
                            ]
                        }
                    ],
                    "ifFalseActivities": []
                }
            }
        ]
    }
}
