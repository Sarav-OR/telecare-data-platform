{
    "name": "pl_run_business_date",
    "properties": {
        "description": "One business date end to end: the three extracts in parallel -> Databricks landing->bronze->silver -> advance the batch clock. Any failure is logged to ctl.run_log and re-raised (try/catch/rethrow).",
        "folder": {
            "name": "telecare/orchestrate"
        },
        "parameters": {
            "run_date": {
                "type": "string"
            },
            "run_id": {
                "type": "string"
            }
        },
        "annotations": [],
        "activities": [
            {
                "name": "log_started",
                "type": "SqlServerStoredProcedure",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.01:00:00",
                    "retry": 2,
                    "retryIntervalInSeconds": 60,
                    "secureOutput": false,
                    "secureInput": false
                },
                "linkedServiceName": {
                    "referenceName": "ls_sql_ehr",
                    "type": "LinkedServiceReference"
                },
                "typeProperties": {
                    "storedProcedureName": "[ctl].[usp_log_step]",
                    "storedProcedureParameters": {
                        "run_id": {
                            "value": {
                                "value": "@pipeline().parameters.run_id",
                                "type": "Expression"
                            },
                            "type": "String"
                        },
                        "pipeline_name": {
                            "value": {
                                "value": "@pipeline().Pipeline",
                                "type": "Expression"
                            },
                            "type": "String"
                        },
                        "run_date": {
                            "value": {
                                "value": "@pipeline().parameters.run_date",
                                "type": "Expression"
                            },
                            "type": "String"
                        },
                        "step": {
                            "value": "run_business_date",
                            "type": "String"
                        },
                        "status": {
                            "value": "STARTED",
                            "type": "String"
                        }
                    }
                }
            },
            {
                "name": "run_file_feeds",
                "type": "ExecutePipeline",
                "dependsOn": [
                    {
                        "activity": "log_started",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "typeProperties": {
                    "pipeline": {
                        "referenceName": "pl_copy_file_feeds",
                        "type": "PipelineReference"
                    },
                    "waitOnCompletion": true,
                    "parameters": {
                        "run_date": {
                            "value": "@pipeline().parameters.run_date",
                            "type": "Expression"
                        },
                        "run_id": {
                            "value": "@pipeline().parameters.run_id",
                            "type": "Expression"
                        }
                    }
                }
            },
            {
                "name": "run_ehr_extract",
                "type": "ExecutePipeline",
                "dependsOn": [
                    {
                        "activity": "log_started",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "typeProperties": {
                    "pipeline": {
                        "referenceName": "pl_extract_ehr",
                        "type": "PipelineReference"
                    },
                    "waitOnCompletion": true,
                    "parameters": {
                        "run_date": {
                            "value": "@pipeline().parameters.run_date",
                            "type": "Expression"
                        },
                        "run_id": {
                            "value": "@pipeline().parameters.run_id",
                            "type": "Expression"
                        }
                    }
                }
            },
            {
                "name": "run_partner_api",
                "type": "ExecutePipeline",
                "dependsOn": [
                    {
                        "activity": "log_started",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "typeProperties": {
                    "pipeline": {
                        "referenceName": "pl_copy_partner_api",
                        "type": "PipelineReference"
                    },
                    "waitOnCompletion": true,
                    "parameters": {
                        "run_date": {
                            "value": "@pipeline().parameters.run_date",
                            "type": "Expression"
                        },
                        "run_id": {
                            "value": "@pipeline().parameters.run_id",
                            "type": "Expression"
                        }
                    }
                }
            },
            {
                "name": "run_databricks",
                "type": "ExecutePipeline",
                "dependsOn": [
                    {
                        "activity": "run_file_feeds",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    },
                    {
                        "activity": "run_ehr_extract",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    },
                    {
                        "activity": "run_partner_api",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "typeProperties": {
                    "pipeline": {
                        "referenceName": "pl_run_databricks_job",
                        "type": "PipelineReference"
                    },
                    "waitOnCompletion": true,
                    "parameters": {
                        "run_id": {
                            "value": "@pipeline().parameters.run_id",
                            "type": "Expression"
                        }
                    }
                }
            },
            {
                "name": "complete_batch",
                "type": "SqlServerStoredProcedure",
                "dependsOn": [
                    {
                        "activity": "run_databricks",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.01:00:00",
                    "retry": 2,
                    "retryIntervalInSeconds": 60,
                    "secureOutput": false,
                    "secureInput": false
                },
                "linkedServiceName": {
                    "referenceName": "ls_sql_ehr",
                    "type": "LinkedServiceReference"
                },
                "typeProperties": {
                    "storedProcedureName": "[ctl].[usp_complete_batch]",
                    "storedProcedureParameters": {
                        "batch_name": {
                            "value": "telecare_daily",
                            "type": "String"
                        },
                        "run_date": {
                            "value": {
                                "value": "@pipeline().parameters.run_date",
                                "type": "Expression"
                            },
                            "type": "String"
                        },
                        "run_id": {
                            "value": {
                                "value": "@pipeline().parameters.run_id",
                                "type": "Expression"
                            },
                            "type": "String"
                        }
                    }
                }
            },
            {
                "name": "log_succeeded",
                "type": "SqlServerStoredProcedure",
                "dependsOn": [
                    {
                        "activity": "complete_batch",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.01:00:00",
                    "retry": 2,
                    "retryIntervalInSeconds": 60,
                    "secureOutput": false,
                    "secureInput": false
                },
                "linkedServiceName": {
                    "referenceName": "ls_sql_ehr",
                    "type": "LinkedServiceReference"
                },
                "typeProperties": {
                    "storedProcedureName": "[ctl].[usp_log_step]",
                    "storedProcedureParameters": {
                        "run_id": {
                            "value": {
                                "value": "@pipeline().parameters.run_id",
                                "type": "Expression"
                            },
                            "type": "String"
                        },
                        "pipeline_name": {
                            "value": {
                                "value": "@pipeline().Pipeline",
                                "type": "Expression"
                            },
                            "type": "String"
                        },
                        "run_date": {
                            "value": {
                                "value": "@pipeline().parameters.run_date",
                                "type": "Expression"
                            },
                            "type": "String"
                        },
                        "step": {
                            "value": "run_business_date",
                            "type": "String"
                        },
                        "status": {
                            "value": "SUCCEEDED",
                            "type": "String"
                        }
                    }
                }
            },
            {
                "name": "log_failed",
                "type": "SqlServerStoredProcedure",
                "dependsOn": [
                    {
                        "activity": "complete_batch",
                        "dependencyConditions": [
                            "Failed",
                            "Skipped"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.01:00:00",
                    "retry": 2,
                    "retryIntervalInSeconds": 60,
                    "secureOutput": false,
                    "secureInput": false
                },
                "linkedServiceName": {
                    "referenceName": "ls_sql_ehr",
                    "type": "LinkedServiceReference"
                },
                "typeProperties": {
                    "storedProcedureName": "[ctl].[usp_log_step]",
                    "storedProcedureParameters": {
                        "run_id": {
                            "value": {
                                "value": "@pipeline().parameters.run_id",
                                "type": "Expression"
                            },
                            "type": "String"
                        },
                        "pipeline_name": {
                            "value": {
                                "value": "@pipeline().Pipeline",
                                "type": "Expression"
                            },
                            "type": "String"
                        },
                        "run_date": {
                            "value": {
                                "value": "@pipeline().parameters.run_date",
                                "type": "Expression"
                            },
                            "type": "String"
                        },
                        "step": {
                            "value": "run_business_date",
                            "type": "String"
                        },
                        "status": {
                            "value": "FAILED",
                            "type": "String"
                        },
                        "message": {
                            "value": "Failed or skipped step - see the ADF monitor for this run id",
                            "type": "String"
                        }
                    }
                }
            },
            {
                "name": "rethrow_failure",
                "type": "Fail",
                "dependsOn": [
                    {
                        "activity": "log_failed",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "typeProperties": {
                    "errorCode": "BUSINESS_DATE_FAILED",
                    "message": {
                        "value": "@concat('Business date ', pipeline().parameters.run_date, ' failed - batch clock NOT advanced; rerun is safe.')",
                        "type": "Expression"
                    }
                }
            }
        ]
    }
}
