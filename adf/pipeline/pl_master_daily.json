{
    "name": "pl_master_daily",
    "properties": {
        "description": "Entry point (scheduled). Reads the next business date from ctl.batch_state and runs it, or does nothing when the sources have no newer day. Concurrency 1: runs never overlap.",
        "folder": {
            "name": "telecare/orchestrate"
        },
        "concurrency": 1,
        "annotations": [],
        "activities": [
            {
                "name": "lkp_next_business_date",
                "type": "Lookup",
                "policy": {
                    "timeout": "0.01:00:00",
                    "retry": 2,
                    "retryIntervalInSeconds": 60,
                    "secureOutput": false,
                    "secureInput": false
                },
                "dependsOn": [],
                "typeProperties": {
                    "source": {
                        "type": "AzureSqlSource",
                        "queryTimeout": "00:10:00",
                        "sqlReaderQuery": "SELECT CONVERT(varchar(10), DATEADD(day, 1, last_completed_date), 23) AS run_date, CASE WHEN DATEADD(day, 1, last_completed_date) <= end_date THEN 1 ELSE 0 END AS has_work FROM ctl.batch_state WHERE batch_name = 'telecare_daily'"
                    },
                    "dataset": {
                        "referenceName": "ds_sql_ehr",
                        "type": "DatasetReference"
                    },
                    "firstRowOnly": true
                }
            },
            {
                "name": "if_new_business_date",
                "type": "IfCondition",
                "dependsOn": [
                    {
                        "activity": "lkp_next_business_date",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "typeProperties": {
                    "expression": {
                        "value": "@equals(activity('lkp_next_business_date').output.firstRow.has_work, 1)",
                        "type": "Expression"
                    },
                    "ifTrueActivities": [
                        {
                            "name": "run_business_date",
                            "type": "ExecutePipeline",
                            "dependsOn": [],
                            "typeProperties": {
                                "pipeline": {
                                    "referenceName": "pl_run_business_date",
                                    "type": "PipelineReference"
                                },
                                "waitOnCompletion": true,
                                "parameters": {
                                    "run_date": {
                                        "value": "@activity('lkp_next_business_date').output.firstRow.run_date",
                                        "type": "Expression"
                                    },
                                    "run_id": {
                                        "value": "@pipeline().RunId",
                                        "type": "Expression"
                                    }
                                }
                            }
                        }
                    ],
                    "ifFalseActivities": []
                }
            }
        ]
    }
}
